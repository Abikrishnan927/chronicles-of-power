# Select ollama or openai-compatible. The browser cannot override the provider.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://localhost:11434
AI_TIMEOUT_MS=90000
# Required only for AI_PROVIDER=openai-compatible. Keep the real key in .env.
AI_API_KEY=
# Ollama settings are also used by the existing game AI.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
PORT=3000
HOST=127.0.0.1
ACCOUNT_API_BASE_URL=http://127.0.0.1:8000
# For production Node support storage, use Supabase's PostgreSQL connection URL.
DATABASE_URL=
# Comma-separated exact HTTPS frontend origins allowed to call the Node API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Build-time public API URL for Vercel; never put a private key in either URL.
PUBLIC_API_BASE_URL=
# Local development fallback only; production refuses file-backed support storage.
SQLITE_DB_PATH=.private/support.sqlite
# Optional MongoDB connection. Leave blank for FAQ and ticket functionality without Mongo.
MONGODB_URI=
# GitHub Status API has no API key; this controls the request timeout in milliseconds.
STATUS_API_TIMEOUT_MS=2500
