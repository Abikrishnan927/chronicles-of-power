function submitGenericAction(){if(!game||game.mode!=='historical-simulation')return;const input=$('#freeform-action'),action=input.value.trim();const event=EVENTS.find(x=>x.id===game.eventId),roles=(event.participants||event.country).split('\u00b7').map(role=>role.trim()),result=COPSimulation.interpretAction(action,{scenarioId:event.id,date:event.date,role:game.role,allowedRoles:roles}),message=$('#simulation-message');if(result.clarification){message.textContent=result.clarification;message.className='simulation-message clarification';return}game.state=COPSimulation.applyEffects(game.state,result.effects);game.choices.push({node:game.node++,title:result.label,action,effects:result.effects});const delayed=Object.keys(result.effects).filter(k=>result.effects[k]!==0).join(', ');game.entries.push({date:event.date,text:`${result.label} — “${action}”`,kind:'hypothetical'});const outcome=`HYPOTHETICAL · DETERMINISTIC MODEL · ${result.label} applied. Immediate state changes: ${effectText(result.effects)}. Potential delayed consequence: effects may reinforce through ${delayed}; this generic scenario has no calibrated forecasting model. Assumption: the action was classified by a fixed keyword rule. No historical claim is implied.`;if(worldMap&&event.coordinates){worldMap.flyTo({center:event.coordinates,zoom:Math.max(worldMap.getZoom(),4.7),duration:1000,essential:true});setSelectedPoint(...event.coordinates)}saveGeneric();renderGenericGame(`<span>${esc(outcome)}</span>`);}
