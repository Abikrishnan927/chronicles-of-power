function wireMapControls(){const zoomIn=$('#zoom-in'),zoomOut=$('#zoom-out'),reset=$('#reset-map'),search=$('#map-search'),period=$('#period-range'),panelToggle=$('#panel-toggle');if(zoomIn)zoomIn.onclick=()=>zoom(.75);if(zoomOut)zoomOut.onclick=()=>zoom(-.75);if(reset)reset.onclick=resetMapView;if(search)search.oninput=searchMap;if(period)period.oninput=applyPeriodFilter;if(panelToggle)panelToggle.onclick=()=>{const collapsed=$('#side-panel').classList.toggle('is-collapsed');panelToggle.textContent=collapsed?'EXPAND +':'COLLAPSE −';panelToggle.setAttribute('aria-expanded',String(!collapsed))};$$('.layer-chip').forEach(button=>button.onclick=()=>toggleMapLayer(button.dataset.layer,button));$('#layers-button').onclick=()=>notify('Use the layer chips to toggle campaign markers, boundaries, and routes.')}
function searchMap(){const input=$('#map-search'),q=input.value.trim(),results=$('#search-results');clearTimeout(geocodeTimer);if(!q){results.classList.add('hidden');return}const matches=EVENTS.filter(event=>`${event.title} ${event.place} ${event.category}`.toLowerCase().includes(q.toLowerCase()));results.innerHTML=matches.slice(0,4).map(event=>`<button class="search-result" data-event="${event.id}"><span>✦</span><b>${esc(event.title)}</b><small>${esc(event.place)}</small></button>`).join('')||'';results.classList.remove('hidden');$$('.search-result[data-event]',results).forEach(button=>button.onclick=()=>{const id=button.dataset.event;results.classList.add('hidden');input.value='';selectMarker(id)});geocodeTimer=setTimeout(()=>searchPlaces(q,results),360)}
async function searchPlaces(query,results){try{const response=await fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(query)}&limit=5&lang=en`);if(!response.ok)return;const data=await response.json();const features=(data.features||[]).slice(0,5);const html=features.map(feature=>{const p=feature.properties||{},coords=feature.geometry?.coordinates;if(!coords)return'';const title=p.name||p.city||p.street||p.county||'Unnamed location',context=[p.city&&p.city!==title?p.city:'',p.state,p.country].filter(Boolean).join(', ');return `<button class="search-result place-result" data-lng="${coords[0]}" data-lat="${coords[1]}" data-title="${esc(title)}" data-country="${esc(p.country||'')}"><span>⌖</span><b>${esc(title)}</b><small>${esc(context)}</small></button>`}).join('');if(html&&$('#map-search').value.trim().toLowerCase()===query.toLowerCase())results.insertAdjacentHTML('beforeend',html);$$('.place-result',results).forEach(button=>button.onclick=()=>{const {lng,lat,title,country}=button.dataset;results.classList.add('hidden');$('#map-search').value='';focusPlace(Number(lng),Number(lat),title,country)})}catch{if(!results.children.length)results.innerHTML='<div class="search-result">Place search is offline. Event search remains available.</div>'}}
function focusPlace(lng,lat,name,country){worldMap?.flyTo({center:[lng,lat],zoom:Math.max(worldMap.getZoom(),5.2),pitch:28,duration:1700,essential:true,curve:1.35});setSelectedPoint(lng,lat);$('#map-tooltip').textContent=[name,country].filter(Boolean).join(', ');$('#map-tooltip').classList.remove('hidden');const related=EVENTS.filter(event=>`${event.place} ${event.title}`.toLowerCase().includes((country||name).toLowerCase()));showLocationBriefing(name,country,related,lng,lat)}

function setupCatalogFilters(){const regions=[...new Set(EVENTS.map(e=>e.region).filter(Boolean))].sort(),countries=[...new Set(EVENTS.map(e=>e.country).filter(Boolean))].sort(),categories=[...new Set(EVENTS.map(e=>e.category).filter(Boolean))].sort();$('#region-filter').innerHTML='<option value="all">All regions</option>'+regions.map(v=>`<option>${esc(v)}</option>`).join('');$('#country-filter').innerHTML='<option value="all">All countries / participants</option>'+countries.map(v=>`<option>${esc(v)}</option>`).join('');$('#category-filter').innerHTML='<option value="all">All categories</option>'+categories.map(v=>`<option>${esc(v)}</option>`).join('');['#status-filter','#country-filter','#region-filter','#category-filter','#era-filter','#date-from','#date-to','#library-search'].forEach(selector=>$(selector)?.addEventListener('input',()=>{$('#catalog-page').value='1';renderLibrary()}));$('#load-more-events')?.addEventListener('click',()=>{$('#catalog-page').value=String(Number($('#catalog-page').value)+1);renderLibrary()})}
renderEvents();buildMarkers();wire();wireMapControls();setupCatalogFilters();renderSources();initCatalogDatabase();window.addEventListener('maplibre-ready',initializeMap,{once:true});if(window.maplibregl||window.maplibreLoadError)initializeMap();
