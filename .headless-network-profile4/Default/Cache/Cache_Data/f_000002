function confirmDecision(){if(!game||selectedChoice===null)return;const node=NODES[game.node],choice=node.options.find(o=>o.id===selectedChoice);if(!choice||!COPSimulation.isAvailable(choice,game.state,game.choices))return;game.state=COPSimulation.applyEffects(game.state,choice.effects);game.choices.push({node:node.id,choice:choice.id,title:choice.title});game.entries.push({date:node.date,text:choice.title,kind:'hypothetical'});if(game.node===0)game.entries.push({date:'JUL 1975',text:'Information policy becomes a central test',kind:'historical'});game.node++;pendingNode={choice,node};selectedChoice=null;persist();selectMarker('emergency');renderGame();showConsequence(choice,node);}
